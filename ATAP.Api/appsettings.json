{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=atap_db;Username=postgres;Password=mysecretpassword",
    "Redis": "localhost:6379,abortConnect=false,connectTimeout=2000"
  },
  "Jwt": {
    "Key": "dev-only-signing-key-change-in-real-deployments-0123456789",
    "Issuer": "atap-api",
    "ExpiresMinutes": 60
  },
  "Cache": {
    "AirportsTTLSeconds": 86400,
    "AircraftsTTLSeconds": 86400
  }
}
