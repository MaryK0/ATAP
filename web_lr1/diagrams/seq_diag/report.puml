@startuml
actor Аналитик
participant "Система" as system
database "БД" as db

Аналитик -> system : Выбрать аэропорт, период, тип

alt Некорректный период (дата начала > даты окончания)
    system --> Аналитик : Сообщение об ошибке
else Период корректен
    system -> db : Запросить данные витрины

    alt Нет данных за период
        db --> system : пусто
        system --> Аналитик : Сообщение "Нет данных"
    else Данные есть
        db --> system : записи
        system --> Аналитик : Отобразить таблицу

        opt Выгрузка отчета
            Аналитик -> system : Нажать "Выгрузить CSV"
            system --> Аналитик : CSV файл
        end
    end
end
@enduml