@startuml
actor Пользователь
participant "Система" as system
database "БД" as db

Пользователь -> system : Ввести логин и пароль
system -> db : Проверить учетные данные

alt Данные неверны
    db --> system : не найдено
    system --> Пользователь : Сообщение "Неверный логин или пароль"
else Данные верны
    db --> system : пользователь найден
    system --> Пользователь : Успешный вход
end
@enduml