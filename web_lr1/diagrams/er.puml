@startchen
top to bottom direction
title Концептуальная ER-диаграмма (нотация Чена)
skinparam entity {
  BackgroundColor White
  BorderColor Black
  FontSize 30
  Paddindg 30
}
skinparam defaultFontSize 50
skinparam nodesep 20
skinparam ranksep 20
skinparam Padding 0
entity Пользователь {
  ID пользователя
  Логин
  Почта
  Пароль
  Роль
}

entity Карта {
  Масштаб
  Центр карты
  ID сессии
  Граничные координаты
  Фильтры
}

entity Аналитическая_витрина {
  ID записи
  Время входа
  Время выхода
  Длительность
  Тип
}

entity Аэропорт {
  Код ICAO
  Код IATA
  Название
  Город
  Страна
  Координаты
}

entity Воздушное_судно {
  ICAO24
  Модель
  Страна
}

entity Рейс {
  Номер
  Позывной
  Время первого появления
  Время последнего появления
}

entity Позиция {
  ID
  Координаты
  Скорость
  Высота
  Курс
  Время фиксации
  Признак на земле
}


relationship Задает_параметры {
}
relationship Выгружает {
}
relationship Просматривает {
}
relationship Отображает_самолеты {
}
relationship Отображает_позиции {
}
relationship Отображает_аэропорты {
}
relationship Анализируется_в {
}
relationship Представлен_в {
}
relationship Используется_для_расчета {
}
relationship Находится_в_зоне {
}
relationship Совершает {
}
relationship Связан {
}
relationship Имеет {
}

Пользователь -1- Задает_параметры
Задает_параметры -N- Карта

Пользователь -1- Выгружает
Выгружает -N- Аналитическая_витрина

Пользователь -1- Просматривает
Просматривает -N- Аналитическая_витрина

Карта -N- Отображает_самолеты
Отображает_самолеты -M- Воздушное_судно

Карта -N- Отображает_позиции
Отображает_позиции -M- Позиция

Карта -N- Отображает_аэропорты
Отображает_аэропорты -M- Аэропорт

Аэропорт -1- Анализируется_в
Анализируется_в -N- Аналитическая_витрина

Рейс -1- Представлен_в
Представлен_в -N- Аналитическая_витрина

Позиция -N- Используется_для_расчета
Используется_для_расчета -N- Аналитическая_витрина

Позиция -N- Находится_в_зоне
Находится_в_зоне -1- Аэропорт

Воздушное_судно -1- Совершает
Совершает -N- Рейс

Рейс -M- Связан
Связан -N- Аэропорт

Рейс -1- Имеет
Имеет -N- Позиция

@endchen
